---
layout: base.njk
---
<article class="entrada">
  <time datetime="{{ date | iso }}">{{ date | fechaLarga }}</time>
  <h1>{{ title }}</h1>
  {% if imagen %}<span class="foto"><img src="{{ imagen }}" alt=""></span>{% endif %}
  <div class="contenido">{{ content | safe }}</div>
  {% if fotos and fotos.length %}<div class="fotos-post">{% for f in fotos %}<img src="{{ f }}" alt="" loading="lazy">{% endfor %}</div>{% endif %}
</article>
