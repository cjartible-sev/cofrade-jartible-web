<div class="hdd-pantalla">
  <div class="hdd-caja" id="hdd">
    <div class="hdd-tabs">
      <button type="button" id="hdd-t1" class="hdd-tab on">📅 Hermandad del día</button>
      <button type="button" id="hdd-t2" class="hdd-tab">∞ Modo infinito</button>
    </div>
    <p class="hdd-ey" id="hdd-ey"></p>
    <h1 class="hdd-h">¿Qué hermandad es?</h1>
